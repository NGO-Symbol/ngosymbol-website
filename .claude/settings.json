{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/task.mjs\" status",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\" # skillpack:session-context",
            "timeout": 10,
            "statusMessage": "Знімок git…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/services_nudge.py\" # skillpack:services-check",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dangerous_bash.py\" # skillpack:dangerous-bash",
            "timeout": 10,
            "statusMessage": "Перевірка команди…"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit_gate.py\" # skillpack:commit-gate",
            "timeout": 300,
            "statusMessage": "Перевірка перед комітом…"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/path_guard.py\" # skillpack:path-guard",
            "timeout": 10,
            "statusMessage": "Перевірка шляху…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/path_guard.py\" # skillpack:path-guard",
            "timeout": 10,
            "statusMessage": "Пошук секретів…"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/read_hygiene.py\" # skillpack:read-hygiene",
            "timeout": 5,
            "statusMessage": "Read hygiene…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs_staleness.py\" # skillpack:docs-staleness",
            "timeout": 10,
            "statusMessage": "Перевірка документації…"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "deep-audit": "user-invocable-only",
    "human-writing": "user-invocable-only",
    "mobile-native": "user-invocable-only",
    "review-2axis": "user-invocable-only",
    "security-audit": "user-invocable-only",
    "self-review": "user-invocable-only",
    "services-check": "user-invocable-only",
    "sync-docs": "user-invocable-only"
  }
}
