{
  "name": "ngosymbol-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @symbol/main dev",
    "dev:street": "pnpm --filter @symbol/istoriia-vulytsi dev",
    "build": "pnpm -r build",
    "generate": "pnpm -r generate",
    "typecheck": "pnpm -r typecheck",
    "kb:validate": "node scripts/kb-validate.mjs",
    "check": "pnpm kb:validate && pnpm ds:contrast && pnpm ds:lint && pnpm typecheck && pnpm build",
    "task:status": "node scripts/task.mjs status",
    "task:new": "node scripts/task.mjs new",
    "task:save": "node scripts/task.mjs save",
    "task:ship": "node scripts/task.mjs ship",
    "dev:design": "pnpm --filter @symbol/design dev",
    "ds:meta": "node scripts/ds-meta.mjs",
    "ds:shot": "node scripts/ds-shot.mjs",
    "ds:lint": "node scripts/ds-lint.mjs",
    "ds:contrast": "node scripts/ds-contrast.mjs",
    "ds:crawl": "node scripts/ds-crawl.mjs",
    "ds:font": "node scripts/font-check.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "fontkit": "^2.0.4",
    "playwright-core": "^1.64.1"
  }
}
